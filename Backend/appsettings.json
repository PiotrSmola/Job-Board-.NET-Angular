{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=JobBoardDb;User=root;Password=;AllowPublicKeyRetrieval=true;"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "JobBoardAPI",
    "Audience": "JobBoardClient",
    "ExpirationInMinutes": 120
  },
  "RateLimiting": {
    "Uploads": {
      "PermitLimit": 30,
      "WindowSeconds": 600,
      "ConcurrencyLimit": 8
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "ConcurrencyLimit": 4
    },
    "PublicLists": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    },
    "AccountEmails": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:4200"
  },
  "Email": {
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Security": "Auto",
      "UserName": "",
      "Password": ""
    },
    "FromAddress": "no-reply@jobboard.local",
    "FromName": "Job Board",
    "Outbox": {
      "PollIntervalSeconds": 10,
      "BatchSize": 20,
      "MaxAttempts": 8,
      "InitialRetryDelaySeconds": 30,
      "MaxRetryDelaySeconds": 3600,
      "SendTimeoutSeconds": 30,
      "RetentionDays": 30
    }
  },
  "Admin": {
    "AllowSeedRefresh": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
