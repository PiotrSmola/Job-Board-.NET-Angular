{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=3306;Database=JobBoardDb;User=root;Password=;AllowPublicKeyRetrieval=true;"
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "JobBoardAPI",
    "Audience": "JobBoardClient",
    "ExpirationInMinutes": 1440
  },
  "RateLimiting": {
    "Uploads": {
      "PermitLimit": 30,
      "WindowSeconds": 600,
      "ConcurrencyLimit": 8
    },
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60,
      "ConcurrencyLimit": 4
    },
    "PublicLists": {
      "PermitLimit": 120,
      "WindowSeconds": 60
    }
  },
  "Admin": {
    "AllowSeedRefresh": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
