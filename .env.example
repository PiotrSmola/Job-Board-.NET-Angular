# Porty na hoście (docker-up.ps1 nadpisuje je pierwszymi wolnymi)
FRONTEND_PORT=4200
BACKEND_PORT=5285
DB_PORT=3306

DB_PASSWORD=jobboard

# Sekret do podpisywania tokenów JWT (min. 32 znaki). Wymagany przez docker-compose.yml;
# docker-up.ps1 generuje losowy, jeśli go brak, i zachowuje istniejący.
JWT_SECRET=

# Klucze magazynu plików załączników aplikacji (SeaweedFS, usługa storage - API zgodne z S3, bez publikowanych portów).
# Wymagane przez docker-compose.yml; docker-up.ps1 generuje losowe (20 i 40 znaków alfanumerycznych), jeśli ich brak,
# i zachowuje istniejące. Własne wartości: tylko litery i cyfry, co najmniej 16 znaków - inne docker-up.ps1 zastępuje
# nowymi (z ostrzeżeniem).
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Reset danych demo z panelu admina (usuwa WSZYSTKICH użytkowników, oferty i aplikacje).
# Domyślnie włączony w lokalnym stacku Dockera; ustaw false, żeby go wyłączyć.
ALLOW_SEED_REFRESH=true

# Konta demo kandydatów i pracodawców ze znanymi hasłami (tabela w README).
# Domyślnie włączone w lokalnym stacku Dockera; ustaw false, żeby tworzyć tylko konta adminów.
SEED_DEMO_ACCOUNTS=true

# Swagger UI backendu (http://localhost:<BACKEND_PORT>/swagger). W lokalnym stacku Dockera domyślnie włączony;
# ustaw false, żeby go wyłączyć (backend w środowisku Production udostępnia Swaggera tylko po jawnym włączeniu).
SWAGGER_ENABLED=true
